# Copy to .env (gitignored) for local development; set the same names as EAS env vars for builds.
# Only publishable client keys belong here (D21). Never put a service-role or secret key in the app.
# Leaving any of these empty is fine: the app works fully offline as a guest, account features show
# "not configured" and cloud sync stays off.

# Clerk publishable key (Clerk Dashboard → API keys). Enables sign-in (Apple, Google, email code).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Supabase project URL + publishable (anon) key. Enables cloud sync, export and delete.
# Local stack: `npx supabase@latest start` prints both (API URL http://127.0.0.1:54321).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
